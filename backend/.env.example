DATABASE_URL=postgresql://crushai:crushai_dev_pw@localhost:5432/crushai
JWT_SECRET=change_this_to_a_long_random_string
PORT=4000
EMBEDDING_SERVICE_URL=http://localhost:8000
UPLOAD_DIR=./uploads

# --- Production-only ---
# NODE_ENV=production                 # enables CORS lockdown + refuses a dev JWT_SECRET
# ALLOWED_ORIGINS=https://crushai.co.il,https://www.crushai.co.il

# --- SMS (optional — omit to stay in dev mode, where the OTP code is
# returned directly in the API response instead of being texted) ---
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# --- Object storage (optional — omit to keep using local disk) ---
# Required on most cloud hosts, whose local filesystem is wiped on every deploy/restart.
# Works with Cloudflare R2, AWS S3, or any S3-compatible provider.
# S3_BUCKET=crushai-uploads
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # omit for real AWS S3
# S3_REGION=auto                                               # AWS: e.g. us-east-1
# S3_PUBLIC_URL=https://cdn.crushai.co.il                      # your bucket's public base URL
